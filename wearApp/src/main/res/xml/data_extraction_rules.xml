<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: nothing is backed up or copied to a new watch, as allowBackup="false" says for older versions.
    The watch keeps only its chat, a setting and the last reply, which belong with the phone it's paired to.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
